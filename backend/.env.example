# Copy to .env and edit values
# ---------------------------------------------------------------------------
# DEVELOPMENT mode (no CORS_ORIGINS needed):
# ---------------------------------------------------------------------------
NODE_ENV=development
ADMIN_EMAIL=admin@unsorted.com
# NOTE (Sprint 22.6 P1): ADMIN_PASSWORD is no longer used to verify logins.
# Admin auth REQUIRES the bcrypt ADMIN_PASSWORD_HASH below — login fails
# safely (HTTP 500) when the hash is missing. This value is kept for
# documentation only; do not rely on it for authentication.
ADMIN_PASSWORD=admin123
PORT=3001
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Customer-facing frontend origin (Sprint 21.1)
# Used to build password-reset links returned by the forgot-password flow.
# In development, the reset URL is returned in the API response; in production
# it should be emailed instead.
# ---------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Admin authentication (JWT) — Sprint 15
# REQUIRED: JWT_SECRET — used to sign/verify admin tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# REQUIRED (Sprint 22.6 P1): ADMIN_PASSWORD_HASH — bcrypt hash of the admin
# password. Login fails safely (HTTP 500) when absent. Generate with:
#   node -e "console.log(require('bcryptjs').hashSync('admin123', 10))"
# Never commit the real hash; set it in the deployment environment.
# ---------------------------------------------------------------------------
JWT_SECRET=please-generate-a-long-random-secret
JWT_EXPIRES_IN=1d
# Customer token lifetime (Sprint 21.1) — defaults to 7d when unset.
JWT_EXPIRES_IN_CUSTOMER=7d
ADMIN_NAME=Administrator
ADMIN_ROLE=admin
ADMIN_PASSWORD_HASH=

# ---------------------------------------------------------------------------
# Rate limiting (Sprint 22.6 P1; extended follow-up) — optional per-IP /
# per-identity caps. Windows are fixed (15 min for logins, cart and order
# creation, 60 min for register / forgot-password). Over-limit requests return
# HTTP 429 with a Retry-After header. Every value is validated at startup:
# an empty, zero, negative or non-numeric entry falls back to the default
# below, so a bad value can never silently disable protection. Defaults shown.
# ---------------------------------------------------------------------------
# RATE_LIMIT_ADMIN_LOGIN=10
# RATE_LIMIT_CUSTOMER_LOGIN=20
# RATE_LIMIT_REGISTER=10
# RATE_LIMIT_FORGOT_PASSWORD=5
# Cart mutations, per authenticated shopper (guests use RATE_LIMIT_CART_IP):
# RATE_LIMIT_CART=120
# Cart mutations, per IP (covers guests and shared NAT/CGNAT abuse):
# RATE_LIMIT_CART_IP=300
# Guest order-tracking lookups, per IP:
# RATE_LIMIT_GUEST_TRACKING=15
# Order creation, per IP:
# RATE_LIMIT_ORDER=30

# ---------------------------------------------------------------------------
# Supabase (PostgreSQL)
# From: Supabase Dashboard -> Project Settings -> API
# ---------------------------------------------------------------------------
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Optional. Server-side only — bypasses RLS. Recommended for backend CRUD later.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Cloudinary (image storage)
# From: Cloudinary Dashboard -> Account Details / API Keys
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
# Optional: Cloudinary media-library folder for admin uploads (default: products).
# CLOUDINARY_UPLOAD_FOLDER=products

# ---------------------------------------------------------------------------
# Razorpay Payment Gateway & Refund Integration (Sprint Razorpay)
# Server-side only — never expose KEY_SECRET, WEBHOOK_SECRET, or INTERNAL_CRON_SECRET
# to the browser, client, or Vercel.
# From: Razorpay Dashboard -> Settings -> API Keys (Key ID & Key Secret)
# From: Razorpay Dashboard -> Settings -> Webhooks (Webhook Secret)
# Internal Cron Secret: Bearer token protecting /api/internal/orders/expire-unpaid
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
INTERNAL_CRON_SECRET=

# ---------------------------------------------------------------------------
# PRODUCTION mode — uncomment and set to only the deployed frontend domain(s).
# Comma-separated list, no trailing slashes, origin only (no paths).
# Requests with no Origin header (curl/Postman/server-to-server) are always
# allowed; ONLY these domains are allowed CORS access:
# ---------------------------------------------------------------------------
# NODE_ENV=production
# PORT=3001
# CORS_ORIGINS=https://unsorted-swart.vercel.app
# CORS_ORIGINS=https://unsorted-swart.vercel.app,https://admin.unsorted.com

