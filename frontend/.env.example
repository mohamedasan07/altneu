# ALTNEU — Frontend Environment Configuration

# Supabase (PostgreSQL client)
# From: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Razorpay Payment Gateway (Test Mode / Production)
# Public Key ID ONLY.
# WARNING: NEVER expose RAZORPAY_KEY_SECRET or RAZORPAY_WEBHOOK_SECRET to frontend code or client bundles!
VITE_RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID

# Backend API Base URL
# - Localhost: Leave empty or unset to use the Vite dev server proxy (/api -> backend).
# - Hosted Staging / Preview: REQUIRED (e.g. https://staging-api.example.com).
#   Staging previews fail safely if this is omitted to prevent accidental fallback to production.
# - Production: Optional override; defaults to production backend if omitted.
VITE_API_BASE_URL=https://your-backend-api.example.com
